# Vite only exposes variables prefixed with VITE_.

# Port the dev and preview servers listen on. Defaults to 3001, which keeps the
# admin panel off 3000, the port the public site uses.
VITE_PORT=3001

# Base URL of the API server, including /api. When unset the panel derives it
# from the page's own host and VITE_API_PORT (5000) — set it in every deploy.
VITE_API_URL=http://localhost:5000/api

# API port used only for that derived fallback. Defaults to 5000.
# VITE_API_PORT=5000
