# Vite only exposes variables prefixed with VITE_.

# Port the dev and preview servers listen on. Defaults to 3000.
VITE_PORT=3000

# Base URL of the API server, including /api. When unset the app derives it
# from the page's own host and VITE_API_PORT (5000) — set it in every deploy.
VITE_API_URL=http://localhost:5000/api

# API port used only for that derived fallback. Defaults to 5000.
# VITE_API_PORT=5000
