# Port the API server listens on.
PORT=5000

# ---------- CORS (comma separated) ----------
# Origins allowed to call the API. Each may list several comma-separated hosts.
# Nothing is allowed when both are unset — set them in every deploy.
# These must match the front-end dev server ports (VITE_PORT in client/.env,
# default 3000, and admin/.env, default 3001) — a mismatch shows up as every
# request being blocked, since the allowlist fails closed.
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/charity

# ---------- Admin session (JWT) ----------
# Two independent secrets — each a long random string, and they must differ.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Signs the short-lived access token the panel sends as a Bearer header.
JWT_ACCESS_SECRET=
# Signs the long-lived refresh token, which is kept in an httpOnly cookie scoped
# to /api/auth and never reaches JavaScript. Sharing one secret between the two
# would let an access token be replayed at /auth/refresh, so keep them separate.
JWT_REFRESH_SECRET=

# How long an access token is good for. Short by design — it lives in the
# panel's sessionStorage, so its lifetime is the exposure window. Defaults 15m.
JWT_ACCESS_EXPIRES=15m
# How long the admin can stay signed in without re-entering the password. The
# cookie's lifetime is set from this too, and it is rotated on every refresh.
# Defaults to 7d.
JWT_REFRESH_EXPIRES=7d

# Credentials for the single admin login.
ADMIN_USERNAME=
# bcrypt hash of the password — generate with `npm run hash-password`.
ADMIN_PASSWORD_HASH=
# Deprecated plaintext fallback, only read when ADMIN_PASSWORD_HASH is unset.
# Leave empty; it logs a warning on every start.
ADMIN_PASSWORD=

# Cloudinary — image uploads for gallery and projects.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder for this deploy's uploads (e.g. `charity-prod`), so a
# staging and a production deploy can share one Cloudinary account without
# mixing their media. Leave empty to upload to gallery/, projects/ and
# settings/ at the account root. Only affects new uploads.
CLOUDINARY_FOLDER=

# Razorpay — donation payments.
RAZORPAY_API_KEY=
RAZORPAY_SECRET_KEY=
# Secret configured on the Razorpay webhook endpoint, used to verify signatures.
RAZORPAY_WEBHOOK_SECRET=
